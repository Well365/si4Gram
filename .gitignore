# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd

# Editors
.vscode/
.idea/
*.swp
*~

# Local secrets / config never belong here
.env
.env.*
secutg.json
*.p12
*.pem
*.key
*.mobileprovision

# Local Claude Code state
.claude/settings.local.json
.claude/worktrees/

# ios/ is an upstream-based source tree with its own .gitignore. Upstream ships
# placeholder (fake) signing files and editor settings there on purpose; keep
# the root rules above from hiding them. Real signing files stay ignored.
!/ios/build-system/fake-codesigning/**
!/ios/build-system/example-configuration/provisioning/**
!/ios/buildbox/fake-codesigning/**
!/ios/third-party/**
!/ios/**/.vscode/
