load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")

# SECUTG: build fingerprint for the "About secuTG" sheet (PLAN.md 3.11 rule 3). Make.py passes
# `--define=secutgBuild=<git short hash · build date>` (empty when git is unavailable); the value is
# written into a generated Swift constant at build time and never filled in by hand.
#
# SECUTG-HOOK (PLAN.md 3.53): `isStoreBuild` is the App Store submission switch, a pure Bazel build
# parameter — Make.py always passes `--define=secutgStoreBuild=1` (with `--secutgStoreBuild`) or `=0`
# (the default, same as every build before PLAN.md 3.53 existed), the same way it always passes
# `--define=secutgBuild=...` above. There is no runtime config file switch for this.
genrule(
    name = "SecutgBuildInfoSource",
    outs = ["SecutgBuildInfo.generated.swift"],
    cmd = """cat > $@ <<'SWIFT'
// GENERATED by //submodules/SecutgBuildInfo (Bazel genrule) — do not edit
public enum SecutgBuildInfo {
    /// git short hash · build date, injected by Make.py; empty when unavailable
    public static let fingerprint = "$(secutgBuild)"
    /// App Store submission build switch (PLAN.md 3.53), injected by Make.py's --secutgStoreBuild flag.
    public static let isStoreBuild = "$(secutgStoreBuild)" == "1"
}
SWIFT
""",
)

swift_library(
    name = "SecutgBuildInfo",
    module_name = "SecutgBuildInfo",
    srcs = [":SecutgBuildInfoSource"],
    copts = [
        "-warnings-as-errors",
    ],
    visibility = [
        "//visibility:public",
    ],
)
